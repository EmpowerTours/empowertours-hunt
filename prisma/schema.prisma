// EmpowerTours Treasure Hunt — free-roam GPS collection feeding the TURBO cohort.
//
// TWO ECONOMIES, DELIBERATELY DIFFERENT. Do not merge them.
//
//   CACHE FINDS pay TURBO CREDIT (see CreditLedger). Credit is denominated in
//   WMON-wei so it is directly comparable to TurboCohort.tierPrice — ~139 WMON
//   is one month of Explorer. Credit is NOT withdrawable. It is a discount on a
//   subscription, so a find costs margin rather than cash, and only converts to
//   spend when someone actually joins. This is what makes acquisition cost
//   measurable instead of a guess.
//
//   SPAWNS pay real native MON (see Spawn -> Payout). Small, random, ephemeral,
//   visible on the radar. This is the only path in the system where money
//   actually leaves the treasury, which is why every bound on it is atomic.
//
// Design notes that are load-bearing, not decoration:
//
//  * Cache coordinates live ONLY here and in server memory. They are never
//    serialized to a client response. Spawn coordinates ARE public by design —
//    the whole mechanic is seeing one appear — so for spawns the defence is
//    movement plausibility, never secrecy.
//  * Every claim attempt is persisted with its FINAL outcome. A dispute is
//    answered by replaying ClaimAttempt rows through lib/hunt/validator.ts,
//    which is a pure function precisely so that replay is exact. A row must
//    never say `accepted` for a claim that was ultimately refused.
//  * Paying MON is irreversible, so it is a two-phase commit: a Spawn collect
//    accrues a debt, a Payout settles it. Separate rows because the send must
//    not happen inside the transaction that decides whether it was earned.
//
// WEI IS `Decimal @db.Decimal(78, 0)`, NOT `String`.
// Scale 0 means Postgres itself rejects "0.5", "1e18", "0x10" and "abc" at
// write time. A malformed reward string used to be able to throw out of
// BigInt() and wedge a payout mid-send; the database now refuses to store one.
// Precision 78 holds any uint256. Never widen this to String for convenience.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The payout lifecycle. Read the transitions before changing any of them —
// each value exists to answer exactly one question: "may this row be sent?"
//
//   PENDING              earned, not yet released              -> APPROVED | VOIDED
//   APPROVED             released, not yet broadcast           -> SENDING  | VOIDED
//   SENDING              nonce pinned, broadcast may already   -> SENT | FAILED
//                        have happened. NEVER auto-retryable.     | NEEDS_RECONCILIATION
//   SENT                 receipt confirmed on Monad            terminal
//   FAILED               failed BEFORE the money could move.   -> APPROVED (human)
//                        Only ever set when txHash IS NULL.
//   NEEDS_RECONCILIATION broadcast, outcome unknown. A human   -> SENT | FAILED
//                        or reconciler resolves it against the
//                        chain. Re-sending is forbidden.
//   VOIDED               refused by an admin                   terminal
enum PayoutStatus {
  PENDING
  APPROVED
  SENDING
  SENT
  FAILED
  NEEDS_RECONCILIATION
  VOIDED
}

enum AdminRole {
  // Can review the queue, but cannot release money.
  VIEWER
  // Can approve and void payouts, manage hunts and caches.
  OPERATOR
  // Can additionally manage admins themselves.
  OWNER
}

// How a credit entry arose. Append-only ledger, so this is the audit vocabulary.
enum CreditReason {
  CACHE_FIND
  ADMIN_GRANT
  ADMIN_REVOKE
  TURBO_REDEMPTION
}

// ---------------------------------------------------------------------------
// CAREER TRACKS
//
// A track is a curriculum PLUS a verifier. The curriculum is the cheap half —
// anyone can write 52 weeks of topic titles in an afternoon. The verifier is
// what makes a completed step mean anything, which is why it is declared per
// step and enforced structurally rather than left to the route to remember.
//
// Two verifiers exist because two already work in production:
//   GPS_FIND      a Find row in THIS database proves the player was there.
//   GITHUB_PUSH   a webhook-confirmed push in the TURBO repo proves the work.
// ADMIN_ATTEST is the escape hatch for everything else and is deliberately
// unpleasant: it records the human who vouched, and it can never be the
// default because a step must name it explicitly.
//
// NOTE ON REPEATABLE STEPS — a step here completes AT MOST ONCE per
// enrollment. Daily attendance ("walked to school again today") is therefore
// NOT expressible yet, and cannot be bolted on by relaxing the unique key:
// `Find.@@unique([cacheId, playerId])` already forbids finding the same cache
// twice, so the evidence for a second visit cannot exist in the first place.
// Recurring attendance needs its own mechanic. Do not fake it by cloning a
// cache per day.
// ---------------------------------------------------------------------------

// How a step is proven. A completion carries the verifier that ACTUALLY proved
// it, and the route refuses to write one whose verifier differs from the
// step's — otherwise GPS evidence could complete a coursework step.
//
// SUBMISSION is deliberately a COMPLETION check, not a QUALITY one: an
// artifact arrived, and nobody has said it is any good. That is the same
// standard GITHUB_PUSH holds — a file landed at the expected path — and it is
// weaker than it sounds, so be honest about what a completed step claims.
//
// It is acceptable while TOURS is worth nothing, because there is no reason to
// forge a study note for a token with no sink. It stops being acceptable the
// moment TOURS is worth money. The upgrade path is review of the stored
// artifact, which is possible ONLY because the CID is captured now — a
// submission never collected cannot be audited later.
enum VerifierKind {
  GPS_FIND
  GITHUB_PUSH
  // An artifact the learner uploaded — a photo of handwritten notes, a
  // write-up. Stored, not yet reviewed.
  SUBMISSION
  ADMIN_ATTEST
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  // The learner stopped. Kept rather than deleted so their completions, and
  // any TOURS those completions justified, remain auditable.
  WITHDRAWN
  // Set by an admin. Distinct from Player.suspendedAt: a player may be fine in
  // the hunt but barred from one track.
  SUSPENDED
}

model Player {
  id String @id @default(cuid())

  // Stored lowercased, always. A checksummed row would silently never match
  // the lowercased lookup in lib/auth and lock a registered player out.
  walletAddress String @unique

  // Mera passkey credential id, when the player onboarded via passkey rather
  // than an injected wallet. The wallet address is still the primary identity;
  // this only records how they proved it.
  passkeyCredentialId String? @unique

  // TURBO registry handle. Links a hunt player to their builder identity so
  // credit can be redeemed against their cohort subscription.
  turboUsername String?
  displayName   String?

  // Signup is open — anyone may register. `active` is therefore a moderation
  // flag, not a whitelist: it starts true and an admin sets it false. Claims
  // are rejected on it before any positional check runs, so a banned wallet
  // learns nothing about cache locations from the shape of the error.
  active Boolean @default(true)

  // Set when an admin suspends a wallet for suspected spoofing; kept distinct
  // from `active` so a suspension is legible in the audit trail.
  suspendedAt   DateTime?
  suspendReason String?

  // Running TURBO credit balance in WMON-wei. Derived from CreditLedger and
  // updated in the same transaction as the ledger row, so the two can be
  // reconciled against each other. The ledger is the source of truth.
  creditBalanceWei Decimal @default(0) @db.Decimal(78, 0)

  createdAt DateTime @default(now())

  finds          Find[]
  attempts       ClaimAttempt[]
  payouts        Payout[]
  hintRequests   HintRequest[]
  huntStats      PlayerHunt[]
  credits        CreditLedger[]
  spawns         Spawn[]
  enrollments    Enrollment[]
  cotas          Cota[]
  redemptions    Redemption[]
  warranties     PlantWarranty[]
  createdHunts   Hunt[]              @relation("HuntCreator")
  surveyedZones  Zone[]
  editions       Edition[]
  editionClaims  EditionClaim[]
  perpKey        PerpKey?
  cotaFills      CotaFill[]
  cotaOrders     CotaOrder[]
  agentDecisions CotaAgentDecision[]
  cotaNotes      CotaNote[]

  @@index([turboUsername])
  @@index([active, suspendedAt])
}

// A hunter's Perpl trading key, held server-side so the Cota agent can execute
// bounded trades on their behalf. Encrypted at rest (AES-256-GCM, key derived
// from COTA_KEY_ENC_SECRET; see lib/cota/keystore.ts). Safe by construction:
// the key can TRADE but Perpl never lets it WITHDRAW, and every order is
// leash-gated + anchored — a full compromise can only trade within the leash,
// never move a hunter's money. One per player.
model PerpKey {
  id String @id @default(cuid())

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String @unique

  // The Perpl account / wallet address the key trades for. Kept in the clear so
  // the executor can select without decrypting.
  account String

  // AES-256-GCM sealed credential (api key + Ed25519 secret), base64. The
  // playerId is the GCM AAD, so a row cannot be replayed under another player.
  salt       String
  iv         String
  authTag    String
  ciphertext String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One venue fill the Cota agent placed for a player, normalised to the units the
// PnL fold reads (lib/cota/venue/pnl.ts). Perpl sends no PnL or entry price, so
// this ledger IS the entry-price record: fold these fills and you recover the
// open position's VWAP entry and the day's realised loss — the daily-loss stop's
// only data source. Direction is derived from the order TYPE the agent sent
// (T_OPEN_LONG/T_CLOSE_SHORT = buy +1; T_OPEN_SHORT/T_CLOSE_LONG = sell -1),
// because the fill frame itself carries no side.
model CotaFill {
  id String @id @default(cuid())

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  // The Perpl account/wallet this fill is for. A player who re-enrols on a
  // different account must not have the two ledgers folded together.
  account String

  marketId  Int
  // +1 buy, -1 sell. Signed so the fold can net a position toward zero.
  direction Int
  // Absolute size in market units, and fill price in USD — both descaled off the
  // wire's scaled integers at record time so the fold reads plain numbers.
  sizeUnits Float
  priceUsd  Float
  // Total (protocol+builder) fee in USD. Always a cost against the day.
  feeUsd    Float
  // The order rq the fill came under, to count DISTINCT orders per day.
  orderId   Int
  filledAt  DateTime

  // "observed" | "adopted" — see lib/cota/venue/pnl.ts: FillSource. Nullable
  // with NO default on purpose: a row written before this column existed has
  // unknown provenance, and both rows in the ledger at the time it was added
  // came through adoption, so a default of "observed" would have asserted the
  // opposite of the truth on exactly the rows it applied to. Not an enum
  // because widening one is a migration and this will likely gain a third
  // value (a venue-supplied fill history, if Perpl ever exposes one).
  source       String?
  // Perpl's OWN mark at record time, or null when there is no honest value —
  // notably on every adopted row, whose timestamp is the reconcile moment
  // rather than the fill. Captured here because it is unrecoverable later: no
  // historical mark feed exists, and `filledAt` is not precise enough to look
  // one up against. Measures spread/slippage vs the price we were shown; it is
  // NOT an independent benchmark and cannot show adverse selection.
  venueMarkUsd Float?

  createdAt DateTime @default(now())

  @@index([playerId, account, filledAt])
}

/// An order this agent SENT to the venue that the venue accepted but that had
/// not filled by the time the placing socket closed.
///
/// Perpl accepts an order on the gateway (code 0) and fills it on-chain a moment
/// later. `placeOrder` holds a socket open only long enough to place, so a fill
/// that lands after it closes was never seen and never recorded — and then the
/// fill ledger disagrees with the venue's positions forever, the daily-loss read
/// fails closed, and the hunter is stuck. That is what happened on the first
/// real fill this executor ever produced (account 5273, 2026-09-14).
///
/// A row here is the agent's own record that it authorised a specific order
/// under the leash. It is what lets a later position that MATCHES one be adopted
/// into the ledger automatically, while a position matching nothing still fails
/// closed and needs the hunter to adopt it explicitly. Without this row the two
/// cases are indistinguishable, and treating them alike would either block
/// every hunter or silently swallow trades the agent never made.
model CotaOrder {
  id String @id @default(cuid())

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  /// The Perpl account/wallet, lowercased. Same scoping rule as CotaFill.
  account String

  marketId  Int
  /// +1 buy, -1 sell.
  direction Int
  /// Size requested, in market units.
  sizeUnits Float
  /// The venue's request id for the order, when it gave one.
  orderId   Int

  /// Set once the order's size has been accounted for in CotaFill — either
  /// because the placing socket saw the fill, or because a later read adopted
  /// it. A resolved row is history, not an outstanding claim.
  resolvedAt DateTime?

  /// Set when an order is KNOWN never to have reached the chain, so it is not a
  /// trade and must not consume the leash's trades-per-day ceiling, nor sit
  /// around able to "explain" a position it never opened.
  ///
  /// This is the ONE flag in this table that loosens a bound, so nothing sets it
  /// automatically. It exists because eight orders on account 5273 were acked by
  /// the gateway and discarded by the chain (OrderDescIdTooLow — a stale `rq`
  /// from our own client), and then consumed a ceiling of five on a day when a
  /// single order had actually traded. The venue proved they were dead: `lfr`
  /// stood at 2 for the account's whole life, the position was exactly the two
  /// known fills, and `tv` was their two notionals to the microdollar.
  ///
  /// The forward path no longer creates such rows at all — the trade route skips
  /// the write when venueRefusedOrder sees the verdict on mt 24. This is for the
  /// case that verdict never arrives, and for repairing what predates the guard.
  deadAt DateTime?

  /// Why it is dead, in words, for whoever reads this row later. Free text on
  /// purpose: the venue's reason names are the useful content and they are not a
  /// closed set this schema should pretend to know.
  deadReason String?

  /// Set when the venue itself said this order TRADED — `expectsFill` on its mt
  /// 24, meaning size changed hands and only the price frame is still in flight.
  ///
  /// This is EVIDENCE where the pending-order age cap is a heuristic. A row is
  /// normally allowed to explain a position only for a short while, so a stale
  /// row cannot be used to adopt something it never opened. But an order the
  /// venue has confirmed traded is not a guess about the future: it has already
  /// happened, and the only thing missing is our record of the price. Such a row
  /// stays adoptable however long it takes us to read again, which is what stops
  /// a hunter who waits half an hour being sent to a manual reconcile for a fill
  /// the venue told us about at the time.
  venueFilledAt DateTime?

  /// The venue's status name for this order, for whoever reads the row later.
  venueStatus String?

  placedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([playerId, account, resolvedAt])
  /// Declared here only to MATCH the index that migration
  /// 20260915000000_cota_order_dead already created in SQL. The schema never
  /// knew about it, so `prisma migrate dev` wanted to DROP it — and it backs
  /// the trades-per-day ceiling count, which filters on exactly these three
  /// to exclude orders the venue never forwarded. Dropping it would have put
  /// a sequential scan inside a money-path bound.
  @@index([playerId, account, deadAt])
}

/// One agent decision, kept so a hunter can read what their agent has been doing.
///
/// The agent is a POLL: it wakes, decides, and returns its answer to whichever
/// scheduler called it — a GitHub job or a cron on a machine in someone's house.
/// Nothing a hunter can see. Without this table the honest answer to "what has it
/// been doing" is "check the Actions tab of a repository you may not own", which
/// is not an answer.
///
/// Every tick is recorded, including the boring ones. "It looked and held" is
/// the state an agent spends almost all of its life in, and a log that only
/// shows trades makes an agent that is working look like one that is asleep.
model CotaAgentDecision {
  id String @id @default(cuid())

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  /// The leash acted under, by digest — the same reference the grant uses.
  cotaDigest String

  /// "nothing" | "close" | "open".
  act    String
  /// Why, in the words decide() used. For reading, never for branching.
  why    String
  /// Whether this run was allowed to send. A dry run decides and stops.
  dryRun Boolean @default(false)

  /// The numbers behind the decision — net PnL on a close, size on an open,
  /// the venue's verdict if an order went out. Shape follows the act.
  detail Json?

  at DateTime @default(now())

  @@index([playerId, at])
  @@index([cotaDigest, at])
}

/// A hunter's private note about one leash — stored as ciphertext this server
/// cannot read.
///
/// The key is derived in the browser from the passkey's PRF under a salt that is
/// not the wallet's, imported non-extractable, and never transmitted. So these
/// columns are not "encrypted at rest" in the usual sense, where the operator
/// holds the key and promises not to look. There is no key here to hold.
///
/// Which means: no support path can recover a note, no backup contains a
/// readable one, and no instruction to us can produce the plaintext. That is the
/// point, and the cost is that losing the passkey loses the notes. It holds a
/// hunter's own remarks for exactly that reason, and nothing the system needs.
model CotaNote {
  id String @id @default(cuid())

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  /// The leash the note is about. Also the AES-GCM aad, so a row moved to
  /// another digest fails to open rather than decrypting under the wrong bound.
  cotaDigest String

  /// base64. A fresh IV per write — GCM under a stable key demands it.
  iv         String
  ciphertext String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([playerId, cotaDigest])
}

model Hunt {
  id          String    @id @default(cuid())
  name        String
  description String?
  active      Boolean   @default(false)
  startsAt    DateTime?
  endsAt      DateTime?

  // --- Verifier rules (fed straight into validateClaim) ---
  /// The Sembrador who planted this hunt, when a player made it.
  ///
  /// Null for hunts an admin created — including every hunt that existed
  /// before creation was opened up. Nullable rather than backfilled to the
  /// deployer, because "the platform made this" and "a person made this" are
  /// different facts and the second one is what a report path needs.
  createdBy         Player? @relation("HuntCreator", fields: [createdByPlayerId], references: [id], onDelete: SetNull)
  createdByPlayerId String?

  maxAccuracyM        Int @default(30)
  maxSpeedKmh         Int @default(60)
  cooldownSeconds     Int @default(60)
  maxClockSkewSeconds Int @default(120)

  // --- Credit bounds (cache finds) ---
  // Ceiling on total TURBO credit this hunt may ever issue, in WMON-wei.
  budgetCreditWei Decimal @default(0) @db.Decimal(78, 0)

  // Running total of issued credit. Exists so the ceiling is enforced as one
  // atomic conditional UPDATE
  //   (... WHERE spentCreditWei + reward <= budgetCreditWei)
  // instead of a read-then-write. A read-then-write let K concurrent claims
  // all observe the same total and all pass, overspending by (K-1) rewards.
  // Never recompute this by summing Find rows at request time.
  spentCreditWei Decimal @default(0) @db.Decimal(78, 0)

  // Belt-and-braces per-wallet cap; 0 disables it. Enforced via the atomic
  // counter on PlayerHunt, never by counting Find rows in application code.
  maxFindsPerPlayer Int @default(0)

  // --- MON bounds (spawns) — the only path where cash actually leaves ---
  spawnEnabled Boolean @default(false)

  // Hard ceiling on native MON this hunt can ever pay out, and its atomic
  // running total. Same CAS pattern as credit above.
  budgetMonWei Decimal @default(0) @db.Decimal(78, 0)
  spentMonWei  Decimal @default(0) @db.Decimal(78, 0)

  // Inclusive bounds on a single random spawn's value.
  spawnMinWei Decimal @default(0) @db.Decimal(78, 0)
  spawnMaxWei Decimal @default(0) @db.Decimal(78, 0)

  // Spawns are placed in an annulus around a player's last VERIFIED position,
  // so collecting one always requires real movement.
  spawnMinRadiusM Int @default(80)
  spawnMaxRadiusM Int @default(600)

  /// Spawn radius to use when this hunt has NO surveyed walkable area.
  ///
  /// 0 — the default and the safe one — means an unsurveyed hunt places
  /// nothing at all. That is deliberate: without a survey, placement would
  /// eventually drop MON in a river or across a highway and then pay somebody
  /// for reaching it.
  ///
  /// Above 0, an unsurveyed hunt may place spawns within this many metres of
  /// the player's VERIFIED position, on the only evidence available — they are
  /// demonstrably standing somewhere a human can stand. That inference decays
  /// with distance, which is why this is a separate, smaller radius rather
  /// than a flag that reuses spawnMaxRadiusM: at 600m the drop can be across
  /// the river from a player who is standing on a pavement.
  ///
  /// It is a WEAKER guarantee, and it exists so a hunt can run in a town
  /// nobody has surveyed yet. Survey the area and set this back to 0.
  unsurveyedSpawnRadiusM Int @default(0)

  // Short-lived on purpose: a spoofer needs a plausible track to reach one in
  // time, and an expired spawn cannot be banked for a later burst.
  spawnTtlSeconds Int @default(900)

  // Minimum seconds between spawns granted to the same player.
  spawnCooldownSeconds Int @default(600)

  // How stale PlayerHunt.lastVerified* may be and still anchor a spawn. Spawns
  // are placed relative to the last position the verifier ACCEPTED, so an old
  // fix would let a player collect around somewhere they have since left.
  maxVerifiedFixAgeSeconds Int @default(1800)

  // Ceiling on MON a single player may collect in a rolling 24h.
  spawnDailyCapWeiPerPlayer Decimal @default(0) @db.Decimal(78, 0)

  // --- Auto-approval policy (spawn payouts) ---
  // A payout at or below this amount is approved and swept without a human.
  // 0 disables auto-approval entirely, restoring the strict human gate.
  autoApproveMaxWei Decimal @default(0) @db.Decimal(78, 0)

  // Ceiling on what auto-approval may release across the whole hunt in any
  // rolling 24h. Once exceeded everything falls back to PENDING until a human
  // intervenes. This bounds the worst case if the verifier is ever fooled at
  // scale. A payout whose attempt was flagged never auto-approves regardless.
  autoApproveDailyCapWei Decimal @default(0) @db.Decimal(78, 0)

  /// Minimum wallet age, in seconds, before a payout auto-approves.
  ///
  /// A throwaway wallet minted to spoof one payout is worthless if it cannot
  /// cash out on sight, and time is the one cost a scripted attacker cannot
  /// skip. Below this the payout HOLDS for a human — it is earned, it just
  /// settles after review. 0 disables the gate.
  minAccountAgeSeconds Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caches       Cache[]
  finds        Find[]
  attempts     ClaimAttempt[]
  hintRequests HintRequest[]
  playerStats  PlayerHunt[]
  spawns       Spawn[]
  credits      CreditLedger[]
  zones        Zone[]
  warranties   PlantWarranty[]
  editions     Edition[]

  @@index([createdByPlayerId])
  @@index([active])
}

enum ZoneKind {
  INCLUDE
  EXCLUDE
}

// Ground a spawn may land on.
//
// WHY: `deriveSpawn` places a drop at a uniform bearing and distance from the
// player — a point on an abstract disc, with no idea what is underneath it.
// Without these rows it will eventually put a drop in the river, inside
// someone's house, or across a highway, and then pay the player for reaching
// it. `lib/geo/polygon.ts` filters placement against these zones and declines
// to spawn rather than placing one somewhere unwalkable.
//
// A hunt with no INCLUDE zone places NO SPAWNS AT ALL. That is deliberate:
// "not surveyed yet" and "anywhere is fine" must never be the same state.
// Cache finds are unaffected either way — a human stood at every cache, so they
// are walkable by construction.
//
// UNLIKE `Cache.lat/lng`, THESE COORDINATES ARE NOT SECRET. A zone is the
// public shape of the streets; it reveals nothing about where anything is
// hidden, and the player-facing map needs it to draw the playable area.
model Zone {
  id     String @id @default(cuid())
  hunt   Hunt   @relation(fields: [huntId], references: [id], onDelete: Cascade)
  huntId String

  kind ZoneKind

  /// Human label for the admin list — "plaza", "the river", "the highway".
  name String?

  /// Closed ring as `[{ "lat": Float, "lng": Float }, ...]`. The closing edge
  /// is implicit; do not repeat the first vertex. Fewer than three vertices
  /// encloses nothing and is ignored by `pointInRing`.
  vertices Json

  /// Where this ring came from.
  ///
  /// The distinction is load-bearing, not bookkeeping. An OSM ring is two
  /// coordinates and a radius typed into a script — no effort, no local
  /// knowledge, and rewarding it would reward typing. A WALKED ring is
  /// somebody's GPS track around ground they judged safe, which is the one
  /// thing a remote import cannot produce. Keeping them apart is what makes it
  /// possible to recognise the second without accidentally paying for the
  /// first.
  source ZoneSource @default(ADMIN)

  /// Who walked it. Null for imports and admin-drawn rings.
  surveyedBy         Player? @relation(fields: [surveyedByPlayerId], references: [id], onDelete: SetNull)
  surveyedByPlayerId String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([huntId, active])
  @@index([surveyedByPlayerId])
}

model Cache {
  id     String @id @default(cuid())
  hunt   Hunt   @relation(fields: [huntId], references: [id], onDelete: Cascade)
  huntId String

  // NEVER include these two in a client-facing payload.
  lat Float
  lng Float

  radiusMeters Int @default(25)

  // TURBO credit in WMON-wei. Finds do not pay withdrawable MON.
  rewardCreditWei Decimal @default(0) @db.Decimal(78, 0)

  // Shown to the player only AFTER the find, as a reveal.
  label    String?
  blurb    String?
  photoCid String?

  /// Ordinary enable/disable, set by whoever runs the hunt.
  active Boolean @default(true)

  /// Set when a cache is pulled over a RIGHTS complaint.
  ///
  /// Kept distinct from `active` for the same reason Player.suspendedAt is
  /// kept distinct from Player.active: a takedown and a routine disable look
  /// identical in a boolean, and the audit needs to answer WHY and WHEN, not
  /// merely whether. The claim path filters on both.
  suspendedAt   DateTime?
  suspendReason String?
  suspendedBy   String?

  createdAt DateTime @default(now())

  finds      Find[]
  trackSteps TrackStep[]
  warranty   PlantWarranty?

  @@index([huntId, active])
  @@index([suspendedAt])
}

// Per-(hunt, player) counters. Exists purely so the per-player find cap is an
// atomic database invariant rather than a count() read in the route.
model PlayerHunt {
  hunt     Hunt   @relation(fields: [huntId], references: [id], onDelete: Cascade)
  huntId   String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  findCount       Int     @default(0)
  earnedCreditWei Decimal @default(0) @db.Decimal(78, 0)
  collectedMonWei Decimal @default(0) @db.Decimal(78, 0)

  // Last position the verifier ACCEPTED. Spawns are placed relative to this,
  // never relative to a self-reported position, so a spoofer cannot summon a
  // spawn to arbitrary coordinates by lying about where they are.
  lastVerifiedLat Float?
  lastVerifiedLng Float?
  lastVerifiedAt  DateTime?

  lastSpawnAt DateTime?
  firstFindAt DateTime?
  lastFindAt  DateTime?

  @@id([huntId, playerId])
  @@index([playerId])
}

model Find {
  id       String @id @default(cuid())
  hunt     Hunt   @relation(fields: [huntId], references: [id])
  huntId   String
  cache    Cache  @relation(fields: [cacheId], references: [id])
  cacheId  String
  player   Player @relation(fields: [playerId], references: [id])
  playerId String

  foundAt          DateTime @default(now())
  distanceMeters   Float
  accuracyM        Float
  lat              Float
  lng              Float
  speedKmhFromLast Float?

  // Credit awarded, snapshotted at find time so later edits to
  // Cache.rewardCreditWei cannot retroactively change what a find was worth.
  rewardCreditSnapshot Decimal @db.Decimal(78, 0)

  // Set when this find also proved a career track step. At most one, so a
  // single physical find can never satisfy two steps.
  stepCompletion StepCompletion?

  // Exactly-once for the find, and therefore for the credit it issued.
  @@unique([cacheId, playerId])
  @@index([playerId, foundAt])
  @@index([huntId, foundAt])
}

// Append-only TURBO credit ledger, denominated in WMON-wei. The source of
// truth for Player.creditBalanceWei; the two are written in one transaction so
// a drift between them is detectable. Never UPDATE or DELETE a row here —
// a correction is a new negative entry.
model CreditLedger {
  id       String  @id @default(cuid())
  player   Player  @relation(fields: [playerId], references: [id])
  playerId String
  hunt     Hunt?   @relation(fields: [huntId], references: [id])
  huntId   String?

  reason CreditReason

  // Signed: positive issues credit, negative consumes or revokes it.
  amountWei Decimal @db.Decimal(78, 0)

  // Balance immediately after this entry, so the ledger can be audited without
  // replaying every prior row.
  balanceAfterWei Decimal @db.Decimal(78, 0)

  // One credit entry per find, enforced below. This is what makes a find
  // structurally incapable of issuing credit twice.
  findId String? @unique

  note      String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
  @@index([huntId, createdAt])
  @@index([reason, createdAt])
}

// A random, VISIBLE, ephemeral MON drop — the Pokemon-style mechanic.
//
// Coordinates are public by design, so secrecy is not the control here.
// What bounds the risk instead:
//   * placed in an annulus around the player's last VERIFIED position
//   * targeted at one player, single-collector via an atomic status CAS
//   * short TTL, so it cannot be banked and swept in a burst
//   * amount drawn server-side from a committed seed, never client-influenced
model Spawn {
  id     String @id @default(cuid())
  hunt   Hunt   @relation(fields: [huntId], references: [id], onDelete: Cascade)
  huntId String

  // The player this spawn was generated for. Another player cannot collect it.
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  lat Float
  lng Float

  radiusMeters Int     @default(25)
  amountMonWei Decimal @db.Decimal(78, 0)

  // Commit-reveal over the server CSPRNG draw. `seedCommit` is published when
  // the spawn appears; `seedReveal` is written on collection or expiry, so a
  // player can verify the amount was not chosen after the fact. Cheap
  // auditability without paying for on-chain entropy on every small drop.
  seedCommit String
  seedReveal String?

  expiresAt   DateTime
  collectedAt DateTime?
  // Atomic single-collector guard: a conditional UPDATE ... WHERE collectedAt
  // IS NULL AND expiresAt > now() decides the winner. Never a read-then-write.
  createdAt   DateTime  @default(now())

  payout Payout?

  @@index([playerId, expiresAt])
  @@index([huntId, createdAt])
  @@index([collectedAt])
}

model ClaimAttempt {
  id       String @id @default(cuid())
  hunt     Hunt   @relation(fields: [huntId], references: [id])
  huntId   String
  player   Player @relation(fields: [playerId], references: [id])
  playerId String

  attemptedAt DateTime @default(now())
  clientTs    DateTime
  lat         Float
  lng         Float
  accuracyM   Float?

  // "cache" | "spawn" — both go through the same verifier and the same log.
  kind String @default("cache")

  // Written with the FINAL outcome, inside the same transaction as the Find.
  // Writing this before the budget and cap checks used to record
  // `accepted: true` for claims that were then refused — and this row is what
  // a human reads when deciding whether to pay a disputed claim by hand.
  accepted Boolean
  // Null on accept; a RejectReason literal otherwise.
  reason   String?
  detail   String?

  // Set by the verifier for rejections that suggest tampering rather than a
  // near miss. The admin review queue sorts on this, and a flagged attempt
  // blocks auto-approval of any resulting payout.
  flagged Boolean @default(false)

  @@index([huntId, attemptedAt])
  @@index([playerId, attemptedAt])
  @@index([flagged, attemptedAt])
  @@index([huntId, accepted, attemptedAt])
}

// Hint requests are logged for the same reason claims are: a quantized
// distance oracle is still an oracle, and boundary-walking it to trilaterate a
// cache is invisible unless the probes are recorded. The admin abuse queue
// reads spatial patterns out of this table.
model HintRequest {
  id       String @id @default(cuid())
  hunt     Hunt   @relation(fields: [huntId], references: [id], onDelete: Cascade)
  huntId   String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  lat  Float
  lng  Float
  band String?

  createdAt DateTime @default(now())

  @@index([huntId, createdAt])
  @@index([playerId, createdAt])
}

model Payout {
  id String @id @default(cuid())

  // One payout per spawn. THIS is the constraint that makes double-payment
  // structurally impossible — a unique key on the earning event, not on the
  // money row. Cache finds never create a Payout; they issue credit instead.
  spawn   Spawn  @relation(fields: [spawnId], references: [id])
  spawnId String @unique

  player   Player       @relation(fields: [playerId], references: [id])
  playerId String
  status   PayoutStatus @default(PENDING)

  amountMonWei Decimal @db.Decimal(78, 0)

  // True when released by policy rather than by a person. Kept so the audit
  // can answer "how much has ever moved without a human looking at it".
  autoApproved Boolean   @default(false)
  approvedBy   String?
  approvedAt   DateTime?

  // Pinned before broadcast. A SENDING row is resolved by asking the chain
  // about (treasury, nonce) — never by sending again.
  nonce  Int?
  txHash String? @unique

  sentAt       DateTime?
  failReason   String?
  voidReason   String?
  reconciledBy String?
  reconciledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([playerId, createdAt])
  @@index([status, sentAt])
}

// A career path: "TURBO Developer", "Community Medicine". Steps hang off it.
model Track {
  id String @id @default(cuid())

  // Stable, human-readable key used by external verifiers (the TURBO webhook
  // names a track by slug). Renaming `name` is cosmetic; renaming `slug`
  // breaks every integration, which is why they are separate columns.
  slug        String  @unique
  name        String
  description String?

  // When true, a step may only be completed once every lower ordinal in the
  // track is done. Curricula that build on themselves want this; a track of
  // independent achievements does not.
  sequential Boolean @default(false)

  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       TrackStep[]
  enrollments Enrollment[]

  @@index([active])
}

// One unit of a curriculum — "Week 13: ERC-20 with Foundry", "Attend clinic
// orientation". Ordering is explicit rather than implied by createdAt so a
// curriculum can be reordered without rewriting history.
model TrackStep {
  id      String @id @default(cuid())
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId String

  // Position within the track. Drives the `sequential` gate.
  ordinal Int

  // Stable identifier within the track, e.g. "week-13". Completions are read
  // by humans during a dispute, and an ordinal alone is meaningless once the
  // curriculum has been reordered.
  key String

  title       String
  description String?

  // How this step is proven. There is no default on purpose: a step whose
  // verifier was never chosen must fail to be created, not quietly accept a
  // human's say-so.
  verifier VerifierKind

  // GPS_FIND only — the cache that proves attendance. Nullable because the
  // other verifiers do not use it; the route requires it when verifier is
  // GPS_FIND rather than the schema, since Prisma cannot express a
  // conditional NOT NULL.
  cache   Cache?  @relation(fields: [cacheId], references: [id])
  cacheId String?

  // GITHUB_PUSH only — the deliverable path the webhook must see, e.g.
  // "week-13/src/MyToken.sol".
  deliverablePath String?

  // TOURS this step is worth, in wei (TOURS is 18 decimals like MON). Zero is
  // a legal configuration: a step can be worth progress and nothing else.
  //
  // NOTHING IN THIS REPO PAYS THIS OUT YET, deliberately. The column exists
  // now because the amount must be snapshotted onto the completion AT
  // completion time — a value that was never recorded cannot be recovered
  // later, and back-filling it would mean guessing what a step used to be
  // worth.
  toursAwardWei Decimal @default(0) @db.Decimal(78, 0)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions StepCompletion[]

  // Both keys are unique per track, so a curriculum edit cannot silently
  // create two "week-13"s or two steps at the same position.
  @@unique([trackId, ordinal])
  @@unique([trackId, key])
  @@index([trackId, active])
  @@index([cacheId])
}

// A player on a track. The counters are atomic totals, not derived reads —
// same reasoning as Hunt.spentCreditWei: a count() at request time is a
// read-then-write as soon as two completions race.
model Enrollment {
  id String @id @default(cuid())

  track    Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId  String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  status EnrollmentStatus @default(ACTIVE)

  // Maintained in the same transaction as the StepCompletion that moves them.
  // StepCompletion rows are the source of truth; a drift between the two is
  // detectable precisely because both exist.
  completedStepCount Int     @default(0)
  earnedToursWei     Decimal @default(0) @db.Decimal(78, 0)

  // Highest ordinal completed so far, or null. Cached here so the `sequential`
  // gate is one row read rather than a scan of every completion.
  highestCompletedOrdinal Int?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  suspendedAt   DateTime?
  suspendReason String?

  completions StepCompletion[]

  // One enrollment per player per track.
  @@unique([trackId, playerId])
  @@index([playerId, status])
  @@index([trackId, status])
}

// Proof that a step was done. Append-only: a mistake is corrected by an admin
// action that records itself, never by editing or deleting a completion, since
// this row is what justified issuing TOURS.
model StepCompletion {
  id String @id @default(cuid())

  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId String
  step         TrackStep  @relation(fields: [stepId], references: [id])
  stepId       String

  // The verifier that ACTUALLY proved this, snapshotted. Compared against
  // TrackStep.verifier before the write; stored because a later edit to the
  // step must not rewrite the claim about how an old completion was proven.
  verifier VerifierKind

  // GPS_FIND — the Find row that proves it. Unique, so one physical find can
  // never satisfy two steps.
  find   Find?   @relation(fields: [findId], references: [id])
  findId String? @unique

  // GITHUB_PUSH — the commit SHA the webhook confirmed. Unique per step for
  // the same reason: one push, one completion.
  commitSha String?

  // SUBMISSION — IPFS CID of the uploaded artifact, matching the `photoCid`
  // convention already used on Cache. This is the whole point of the
  // verifier: the evidence outlives the completion, so a step accepted
  // unreviewed today can still be reviewed a year from now.
  submissionCid String?

  // Corroborating GPS, recorded for ANY verifier when the client offered a
  // position. Never load-bearing on its own — a combi ride makes the
  // movement-plausibility check that defends cache finds meaningless for
  // attendance, so this is a signal to compare against later, not a proof.
  // Deliberately not the school's coordinates: this is where the LEARNER
  // claimed to be.
  observedLat      Float?
  observedLng      Float?
  observedAccuracy Float?

  // ADMIN_ATTEST — who vouched. Null for machine-verified completions, and
  // that asymmetry is the point: a completion with no evidence pointer and no
  // attestor is a bug worth finding.
  attestedBy String?
  note       String?

  // What the step was worth when it was completed. Snapshotted so that later
  // edits to TrackStep.toursAwardWei cannot retroactively change what someone
  // earned — the same rule as Find.rewardCreditSnapshot.
  toursAwardSnapshotWei Decimal @db.Decimal(78, 0)

  completedAt DateTime @default(now())

  // THE exactly-once constraint. A unique key on the earning event, not on any
  // downstream reward row — the same shape as Payout.spawnId, and for the same
  // reason: it makes double-crediting structurally impossible rather than
  // conditionally avoided.
  @@unique([enrollmentId, stepId])
  // One push, one completion.
  @@unique([stepId, commitSha])
  // One artifact, one completion — so the same photo cannot be re-submitted
  // against a second step once uploads are cheap.
  @@unique([stepId, submissionCid])
  @@index([enrollmentId, completedAt])
  @@index([stepId, completedAt])
}

model AdminUser {
  id            String    @id @default(cuid())
  walletAddress String    @unique
  role          AdminRole @default(VIEWER)
  label         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  actions AdminAction[]
}

// Append-only. Every privileged mutation writes one row: who released money,
// who suspended a wallet, who edited a cache reward. Never update or delete.
model AdminAction {
  id      String    @id @default(cuid())
  admin   AdminUser @relation(fields: [adminId], references: [id])
  adminId String

  action     String
  targetType String
  targetId   String
  detail     String?
  ip         String?

  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

/// The upper bound a player signs before software may trade for them.
///
/// Stored as scaled integers, not floats: these are ceilings a fill gets
/// compared against, and Decimal(78,0) is how this schema already carries
/// exact on-chain quantities (see Payout.amountMonWei). A rounded ceiling is a
/// ceiling nobody agreed to.
model Cota {
  id String @id @default(cuid())

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  /// Venue the bound authorises. A Cota signed for one venue must not
  /// authorise another — see lib/cota/typedData.ts.
  venue String

  /// Named markets. Empty means the bound authorises nothing, which is a
  /// meaningful state: a signed Cota that permits no market is a revocation.
  markets String[]

  maxNotionalUsdE6  Decimal @db.Decimal(78, 0)
  maxLeverageX100   Decimal @db.Decimal(78, 0)
  maxDailyLossUsdE6 Decimal @db.Decimal(78, 0)
  maxTradesPerDay   Int

  notBefore DateTime
  notAfter  DateTime

  /// Replay protection as signed, kept so a stored Cota can be re-verified
  /// from the row alone rather than trusted because it is in the table.
  clientTs  DateTime
  nonce     String
  signature String

  /// EIP-712 hash of the message above. Unique because the same bound signed
  /// twice is the same bound; a second row would let one agreement be
  /// revoked while its twin stayed live.
  digest String @unique

  /// Set once the digest is anchored on Monad. Null until then — anchoring is
  /// a separate act with its own failure modes, not part of signing.
  anchorTxHash String?   @unique
  anchoredAt   DateTime?

  checks CotaCheck[]

  /// A player may revoke before notAfter. Kept as a timestamp rather than a
  /// boolean so the audit can answer when, not just whether.
  revokedAt DateTime?

  /// Whether the agent may act on this leash WITHOUT the hunter present, and how
  /// far: null/"off", "exit_only" (may close in profit, may never open), or
  /// "full" (may also open).
  ///
  /// Deliberately on the Cota and not on the Player. What is authorised is "act
  /// unattended up to THIS ceiling", so it belongs to the bound it is scoped by:
  /// revoking the leash revokes autonomy with it, and a hunter who signs a larger
  /// leash must consent again rather than have the agent inherit permission for a
  /// ceiling they never agreed to run unattended.
  ///
  /// Set only through an authenticated session. It is a server-side grant
  /// recorded against a signed, anchored bound — it is NOT itself independently
  /// verifiable on chain, and nothing should claim otherwise.
  autonomy   String?
  autonomyAt DateTime?

  /// The hunter's EIP-712 signature over the grant, and the exact fields it
  /// covers. Without these the grant is just a column somebody could write.
  ///
  /// Re-verified on every READ, not only when stored. That is the entire point:
  /// verifying at write time alone would still let anyone with database write
  /// access flip the mode and have the legitimate server trade for them. Read
  /// verification means a forged row simply fails to recover to the hunter's
  /// wallet and reads as "off".
  /// Held while an agent run is acting on this leash, so two schedulers cannot
  /// act on it at once.
  ///
  /// Without it, overlapping runs both read the same open position — the first
  /// run's fill has not settled when the second reads — both decide to close,
  /// and both send. planClose clamps to what the venue reported, which was the
  /// full size for both, so the position does not close: it FLIPS to the other
  /// side at twice the intended trade. A minute-by-minute poll alongside a
  /// scheduler that fires whenever it likes makes that overlap ordinary rather
  /// than unlucky.
  ///
  /// A lease, not a lock: it carries an expiry so a run that dies mid-flight
  /// cannot wedge a hunter's agent forever. Taken with a conditional update, so
  /// the database decides the winner rather than a read-then-write race.
  agentLeaseUntil DateTime?

  autonomySignature String?
  autonomyNonce     String?   @unique
  /// Unix SECONDS. Permission to run unattended may lapse sooner than
  /// permission to trade, so this is the grant's own expiry, not the Cota's.
  autonomyNotAfter  DateTime?

  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
  @@index([venue])
}

/// A player spending TURBO credit on months of a TurboCohort subscription.
///
/// Mirrors Payout in shape and for the same reason: this is the second place
/// value leaves the system, so it gets the same reviewed lifecycle rather than
/// a boolean. It differs in one way that is forced by the chain — the deployed
/// TurboCohort exposes only `payMonthly(uint8)`, which pays for `msg.sender`,
/// so there is no pay-on-behalf entry point and settlement CANNOT be automated
/// the way a MON payout can. A person grants the months and marks the row.
model Redemption {
  id String @id @default(cuid())

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  status RedemptionStatus @default(PENDING)

  /// Whole months bought. Partial months are not offered: they are not
  /// settleable without a person doing arithmetic by hand.
  months Int

  /// What the credit was spent on, in WMON-wei. Equals tierPriceWei * months.
  costCreditWei Decimal @db.Decimal(78, 0)

  /// `TurboCohort.tierPrice(tier)` as read at redemption time.
  ///
  /// Snapshotted for the same reason Find.rewardCreditSnapshot is: the cohort
  /// can change its price on chain, and a later change must not retroactively
  /// alter what this redemption cost.
  tierPriceWei Decimal @db.Decimal(78, 0)

  /// Tier name as presented to the player, e.g. "EXPLORER".
  tier String

  /// The ledger row that debited the credit. Unique, so one redemption can
  /// never be backed by two debits — or, worse, by none.
  ledgerEntryId String @unique

  /// The ledger row that returned the credit, once voided. Null until then.
  refundEntryId String? @unique

  settledBy      String?
  settledAt      DateTime?
  /// How the months were actually granted — a tx hash, a cohort record, a note.
  settlementNote String?

  voidedBy   String?
  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([playerId, createdAt])
}

enum RedemptionStatus {
  /// Credit is already debited and the months are owed to the player.
  PENDING
  /// The months were granted on the cohort.
  SETTLED
  /// Cancelled; the credit was returned by a compensating ledger row.
  VOIDED
}

/// What a Sembrador signed before planting a reward they claim to own.
///
/// The statement text is stored alongside the signature deliberately: it is a
/// signed FIELD, not a reference to terms held elsewhere, so what was signed is
/// what was read and neither can be edited afterwards. See lib/hunt/warranty.ts.
///
/// This proves an affirmation, not a right. Nothing here establishes that the
/// planter actually holds what they say — that is unknowable from a chain — and
/// pretending otherwise would be worse than having no warranty at all. What it
/// does is make the claim specific, dated, attributable, and producible later.
model PlantWarranty {
  id String @id @default(cuid())

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  hunt   Hunt   @relation(fields: [huntId], references: [id], onDelete: Cascade)
  huntId String

  /// Set once the cache exists. A warranty is signed BEFORE the plant, so it
  /// is briefly unattached — and an unattached warranty is a planter who
  /// changed their mind, which is a legitimate end state.
  cache   Cache?  @relation(fields: [cacheId], references: [id], onDelete: SetNull)
  cacheId String? @unique

  nftContract String
  tokenId     Decimal @db.Decimal(78, 0)

  /// The exact sentence signed, and which canonical text it matched.
  statement     String
  statementLang String

  clientTs  DateTime
  nonce     String
  signature String
  digest    String   @unique

  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
  @@index([nftContract, tokenId])
}

/// Every decision the enforcement layer handed an agent.
///
/// This is what the product actually sells. An operator running software on
/// somebody else's money cannot today prove it stayed inside a mandate — they
/// have an API key and an assurance. A row here says: at this instant, the
/// agent reported this state, asked to do this, and was told yes or no against
/// a bound the user signed.
///
/// It does NOT prove the agent obeyed. Nothing server-side can: an agent that
/// ignores a denial, or never calls at all, is defeated only by settlement
/// limits on chain. What this proves is what was asked and what was answered —
/// which is exactly the record a dispute turns on.
///
/// Not every check is stored. A `mustClose` poll returning allow is the steady
/// state and would grow without bound; denials and order attempts are the
/// events anybody ever reads back.
model CotaCheck {
  id String @id @default(cuid())

  cota   Cota   @relation(fields: [cotaId], references: [id], onDelete: Cascade)
  cotaId String

  /// "open" for an order attempt, "halt" for a may-I-still-take-risk poll.
  /// A halt stops new risk; it is never an instruction to close a position.
  kind String

  allowed Boolean
  /// The DenyReason from lib/cota/enforce.ts, null when allowed.
  reason  String?

  /// What the agent said its own position was. Reported, not verified — see
  /// the note above about what this record does and does not establish.
  tradesToday       Int
  lossTodayUsdE6    Decimal @db.Decimal(78, 0)
  openNotionalUsdE6 Decimal @db.Decimal(78, 0)

  /// The proposed order, when there was one.
  market        String?
  notionalUsdE6 Decimal? @db.Decimal(78, 0)
  leverageX100  Decimal? @db.Decimal(78, 0)

  createdAt DateTime @default(now())

  @@index([cotaId, createdAt])
  @@index([allowed, createdAt])
}

enum ZoneSource {
  /// Drawn by an operator.
  ADMIN
  /// Imported from OpenStreetMap. No effort, no local knowledge — see
  /// Zone.source.
  OSM
  /// Walked by a player, with their GPS track as the boundary.
  WALKED
}

/// A copy of an fcempowertours work, placed in the world to be found.
///
/// NOT a Spawn, deliberately. A spawn GIVES native MON and every budget,
/// per-payout cap and rolling 24h ceiling in this schema exists to bound money
/// leaving the treasury. An edition points the other way: it either gives a
/// licence — which is not fungible and cannot be partially paid — or it ASKS
/// the hunter for money. Sharing one model would make every one of those
/// ceilings ambiguous about which direction it bounds.
///
/// "Edition" rather than "pressing": the registry holds MUSIC and ART masters
/// (V3_DESIGN mints with MUSIC_ROYALTY or ART_ROYALTY), and an edition is the
/// right word for a copy of either.
///
/// Coordinates are PUBLIC, like a Spawn and unlike a Cache. You see it on the
/// scope and walk to it; the defence is a short TTL and movement plausibility,
/// not secrecy. See the Spawn model for the same reasoning.
model Edition {
  id     String @id @default(cuid())
  hunt   Hunt   @relation(fields: [huntId], references: [id], onDelete: Cascade)
  huntId String

  /// The player this edition was placed for. Another player cannot take it.
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  /// The contract the work lives in. Today always the v3 LicenseRegistry, so
  /// it could have been implied — it is stored because an itinerary NFT may
  /// later come from a different contract, possibly from an app that is not
  /// fcempowertours at all. One column now, no migration then.
  collection String

  /// The master id within that collection. NOT a foreign key: the catalogue is
  /// another system's and is read on chain.
  masterId String

  /// Mirrored from chain so the scope can draw a track differently from an
  /// image without an RPC call per blip. The chain stays authoritative.
  kind EditionKind

  lat          Float
  lng          Float
  radiusMeters Int   @default(25)

  /// Which tier this drop offers. The venue prices the two separately and
  /// caps the collector one, so they are different products and a hunter may
  /// hold one of each.
  tier EditionTier

  terms EditionTerms

  /// WMON wei, and NULL only when terms is FREE. A PURCHASE with no price must
  /// be unrepresentable, so this is checked in code AND by a database CHECK
  /// constraint in the migration — reject by default, per AGENTS.md rule 2.
  priceWei Decimal? @db.Decimal(78, 0)

  expiresAt DateTime
  /// Atomic single-taker guard, exactly as Spawn does it: a conditional
  /// UPDATE ... WHERE takenAt IS NULL AND expiresAt > now() picks the winner.
  /// Never a read-then-write.
  takenAt   DateTime?
  createdAt DateTime  @default(now())

  claim EditionClaim?

  @@index([playerId, expiresAt])
  @@index([huntId, createdAt])
  @@index([takenAt])
}

enum EditionKind {
  MUSIC
  ART
}

/// The two things SalesController will sell for one master.
///
/// STANDARD is the funnel — cheap or given away, uncapped, its job is to put a
/// wallet on a stranger's phone. COLLECTOR is the scarce one: its own price,
/// its own `maxCollectorEditions` cap. `purchase()` takes this as its
/// `isCollector` flag.
enum EditionTier {
  STANDARD
  COLLECTOR
}

enum EditionTerms {
  /// The relayer buys it and gives it away. SalesController refuses a zero
  /// price, so "free" is an app flow paid by the relayer, never a contract
  /// feature.
  FREE
  /// The hunter pays, out of hunt earnings they have not withdrawn.
  PURCHASE
}

/// One edition of a given work PER TIER per passkey, FOREVER.
///
/// Generalises the old DimeClaim, which was the same machinery keyed to a
/// single hardcoded song. The rule that matters is the unique index: without
/// it one wallet takes the whole supply, which is the only thing that turns a
/// drop into a drained relayer.
///
/// TIER IS PART OF THE KEY, and leaving it out was a real bug caught before
/// deployment. Without it, claiming the free STANDARD licence would
/// permanently bar that passkey from ever buying the COLLECTOR edition — the
/// exact conversion a giveaway exists to create. The venue treats them as two
/// products with two prices and a separate cap; so does this.
///
/// The row is written BEFORE any chain work, so a concurrent double-claim hits
/// the constraint rather than the relayer, and is then advanced by the
/// outcome.
model EditionClaim {
  id String @id @default(cuid())

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  /// The edition that was taken, when it came from a find. Nullable so a claim
  /// can exist without one if a work is ever granted another way.
  edition   Edition? @relation(fields: [editionId], references: [id])
  editionId String?  @unique

  collection String
  masterId   String
  tier       EditionTier

  /// Snapshotted at claim time, so a later wallet change cannot rewrite who
  /// claimed. Same reasoning as the old DimeClaim.
  walletAddress String

  /// What the hunter actually paid, in WMON wei. Zero for a FREE edition.
  /// Recorded rather than derived: the price on the contract can move, and a
  /// receipt has to say what was charged that day.
  paidWei Decimal @db.Decimal(78, 0)

  /// The licence token id, once bought and transferred.
  licenseId String?

  status EditionClaimStatus @default(PENDING)

  purchaseTxHash String? @unique
  transferTxHash String? @unique
  failReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, collection, masterId, tier])
  @@index([status, createdAt])
}

enum EditionClaimStatus {
  PENDING
  SENT
  FAILED
}
